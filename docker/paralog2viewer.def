# Apptainer equivalent of the runtime stage in docker/Dockerfile (local testing).
# Build from the repository root:
#   apptainer build paralog2viewer.sif docker/paralog2viewer.def
# Keep the tool versions below identical to docker/Dockerfile.
Bootstrap: docker
From: mambaorg/micromamba:2.9.0-debian13-slim

%labels
    Description paralog2viewer 0.9.0 runtime (open-source tools only)
    Clair3Version 2.0.3
    SawfishVersion 2.2.1
    VEPVersion 116.1

%files
    pyproject.toml /src/pyproject.toml
    VERSION /src/VERSION
    README.md /src/README.md
    LICENSE /src/LICENSE
    src /src/src

%post
    set -eu
    apt-get update
    apt-get install -y --no-install-recommends fonts-liberation fontconfig procps
    rm -rf /var/lib/apt/lists/*
    fc-cache -f
    export MAMBA_ROOT_PREFIX=/opt/conda
    micromamba create -y -p /opt/recall -c conda-forge -c bioconda \
        --override-channels \
        clair3=2.0.3 sawfish=2.2.1 minimap2=2.31 samtools=1.24 \
        bcftools=1.24 pysam=0.24.1 matplotlib-base=3.10 python=3.11.16 \
        pytorch=2.13.0 longphase=2.0.2 numpy=2.4.6 blast=2.17.0 \
        pip=26.2.2 ca-certificates perl
    micromamba create -y -p /opt/vep -c conda-forge -c bioconda \
        --override-channels ensembl-vep=116.1 perl-compress-raw-zlib=2.214
    micromamba clean -a -y
    printf '#!/bin/sh\nPATH=/opt/vep/bin:$PATH exec /opt/vep/bin/vep "$@"\n' > /usr/local/bin/vep
    chmod +x /usr/local/bin/vep
    export PATH=/opt/recall/bin:/usr/local/bin:$PATH MPLCONFIGDIR=/opt/mplconfig
    pip install --no-cache-dir --no-deps /src
    rm -rf /src
    python -c "import matplotlib.font_manager as fm; fm._load_fontmanager(try_read_cache=False); fm.findfont('Liberation Sans', fallback_to_default=False)"
    chmod -R a+rX /opt/mplconfig

%environment
    export PATH=/opt/annovar:/opt/recall/bin:/usr/local/bin:$PATH
    export CONDA_PREFIX=/opt/recall
    export BCFTOOLS_PLUGINS=/opt/recall/libexec/bcftools
    export MPLBACKEND=Agg
    export MPLCONFIGDIR=/opt/mplconfig

%test
    paralog2viewer --help >/dev/null
    blastn -version >/dev/null
    run_clair3.sh --help >/dev/null
    sawfish --version
    vep --help >/dev/null
